{
  "name": "seventy",
  "version": "3.0.0",
  "private": true,
  "description": "70 \u2014 personal fitness tracker (web app + Android app from one codebase)",
  "type": "module",
  "scripts": {
    "build": "node tools/build-web.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-mlkit/barcode-scanning": "8.2.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "playwright": "1.56.1"
  }
}
