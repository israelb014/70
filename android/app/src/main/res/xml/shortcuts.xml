            android:action="android.intent.action.VIEW"
            android:data="seventy://action/food"
            android:targetPackage="com.ibfix.seventy"
            android:targetClass="com.ibfix.seventy.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="seventy://action/scan"
            android:targetPackage="com.ibfix.seventy"
            android:targetClass="com.ibfix.seventy.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="breathe"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_breathe"
        android:shortcutShortLabel="@string/shortcut_breathe">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="seventy://action/breathe"
            android:targetPackage="com.ibfix.seventy"
            android:targetClass="com.ibfix.seventy.MainActivity" />
    </shortcut>
</shortcuts>
